import { type TSchema } from 'typebox/build/type/types/schema.d.mts';
import { type TIntersect } from 'typebox/build/type/types/intersect.d.mts';
import { type TDistribute } from 'typebox/build/type/engine/evaluate/distribute.d.mts';
import { type TBroaden } from 'typebox/build/type/engine/evaluate/broaden.d.mts';
import { type TUnion } from 'typebox/build/type/types/union.d.mts';
import { type TNever } from 'typebox/build/type/types/never.d.mts';
export type TEvaluateIntersect<Types extends TSchema[], Distribution extends TSchema[] = TDistribute<Types>, Result extends TSchema = TBroaden<Distribution>> = Result;
export declare function EvaluateIntersect<Types extends TSchema[]>(types: [...Types]): TEvaluateIntersect<Types>;
export type TEvaluateUnion<Types extends TSchema[], Result extends TSchema = TBroaden<Types>> = Result;
